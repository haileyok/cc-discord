# ============================================================================
# cc-bridge Docker Configuration
# Copy to .env and fill in required values.
# ============================================================================

# ── Platform Selection (REQUIRED) ───────────────────────────────────
# Which chat platform to bridge to: "discord" or "mattermost"
BRIDGE_PLATFORM=discord

# ── Authentication (REQUIRED — pick one) ─────────────────────────────
# Anthropic API key for Claude CLI sessions
ANTHROPIC_API_KEY=

# OR: Claude Code OAuth token (alternative to API key)
# CLAUDE_CODE_OAUTH_TOKEN=

# ── Zellij ──────────────────────────────────────────────────────────
# Session name for the headless zellij session (default: cc-bridge-worker)
# BRIDGE_ZELLIJ_SESSION=cc-bridge-worker

# ── Bridge Server ──────────────────────────────────────────────────
# Host-side port mapping (container always listens on 8787)
# BRIDGE_PORT=8787

# ── Voice Transcription (optional) ─────────────────────────────────
# Wispr Flow API token for cloud transcription
# WISPR_FLOW_API_TOKEN=

# Local whisper binary path and model (fallback if no Wispr token)
# BRIDGE_WHISPER_BIN=whisper
# BRIDGE_WHISPER_MODEL=base

# ── Tuning ─────────────────────────────────────────────────────────
# Attachment cleanup TTL in seconds (default: 604800 = 7 days)
# BRIDGE_ATTACHMENT_TTL_SECS=604800

# Context window limit override (default: auto-detected from model)
# BRIDGE_CONTEXT_LIMIT=

# ── Docker Compose Volume Paths ────────────────────────────────────
# Host-side bind mount locations. Read by docker-compose.yml, not by
# the application.

# Claude CLI config, session transcripts, skills, plugins
# CLAUDE_HOME_DIR=/opt/cc-bridge/claude-home

# Bridge secrets (secrets.json)
# BRIDGE_CONFIG_DIR=/opt/cc-bridge/config

# Bridge state: SQLite DB, task-settings, attachments
# BRIDGE_STATE_DIR=/opt/cc-bridge/state

# Claude CLI working directory for spawned sessions
# WORKSPACE_DIR=/opt/cc-bridge/workspace
